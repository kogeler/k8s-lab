# -*- mode: ruby -*-
# vi: set ft=ruby :
#
# The local test host: one Debian 13 VM with a spare disk for the LXD pool.
# SSH and egress use vagrant-libvirt's management network (the VM's only NIC);
# the external IPv6 network is simulated inside the VM by the Molecule prepare
# step. Driven by the Makefile next to this file. What is not set here is
# vagrant-libvirt's default (0.12: KVM, virtio disk and NIC, host-model CPU).

Vagrant.configure("2") do |config|
  config.vm.box = "debian/trixie64"
  config.vm.box_version = "13.20260519.1"
  # The version is pinned: the update check would only cost a lookup.
  config.vm.box_check_update = false
  # The default /vagrant share needs NFS or rsync and sudo on the host; nothing
  # in the guest uses it.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # Machine `host`: the Makefile and the inventory (`ansible_host: host`) use
  # this name; the guest hostname is the inventory's host name.
  config.vm.define "host" do |host|
    host.vm.hostname = "k8slab-host"
  end

  config.vm.provider :libvirt do |libvirt|
    libvirt.memory = Integer(ENV.fetch("K8SLAB_MEM_MB", "12288"))
    libvirt.cpus   = Integer(ENV.fetch("K8SLAB_VCPUS", "8"))
    # Domain and volume names start with it; the Makefile's destroy uses them.
    libvirt.default_prefix = "k8slab_"

    # Keep the default video device: without it Debian 13 hangs in early boot.

    # A throw-away VM: guest fsyncs (etcd, LXD) are not waited for, and the
    # images stay sparse.
    libvirt.disk_driver cache: "unsafe", discard: "unmap", detect_zeroes: "unmap"

    # The LXD pool disk. Its serial names it in the guest:
    # /dev/disk/by-id/virtio-k8slab-lxdpool (lxd_storage_source in
    # tests/playbooks/group_vars/all.yml).
    libvirt.storage :file,
                    size: ENV.fetch("K8SLAB_LXD_POOL_GB", "40") + "G",
                    serial: "k8slab-lxdpool",
                    cache: "unsafe", discard: "unmap", detect_zeroes: "unmap"
  end
end
