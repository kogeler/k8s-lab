{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capi-cluster-class values",
  "type": "object",
  "additionalProperties": false,
  "required": ["cluster", "capn", "externalNetwork", "controlPlane", "worker", "loadBalancer"],
  "properties": {
    "global": { "type": "object" },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$" }
      }
    },
    "capn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["infrastructureSecretName"],
      "properties": {
        "infrastructureSecretName": { "type": "string", "minLength": 1 }
      }
    },
    "externalNetwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ipv6Prefix"],
      "properties": {
        "ipv6Prefix": { "type": "string", "pattern": "^[0-9a-fA-F:]*:[0-9a-fA-F:]*/([1-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$" }
      }
    },
    "controlPlane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "flavor", "profilesExtra", "devicesExtra", "featureGates", "apiServerExtraArgs",
                   "controllerManagerExtraArgs", "schedulerExtraArgs", "kubeletExtraArgs", "preKubeadmCommands",
                   "postKubeadmCommands", "certificateValidityPeriodDays", "certificatesExpiryDays"],
      "properties": {
        "image": { "$ref": "#/$defs/image" },
        "flavor": { "type": "string" },
        "profilesExtra": { "$ref": "#/$defs/names" },
        "devicesExtra": { "$ref": "#/$defs/devices" },
        "featureGates": { "type": "object", "additionalProperties": { "type": "boolean" } },
        "apiServerExtraArgs": { "allOf": [{ "$ref": "#/$defs/args" }, { "items": { "properties": { "name": { "not": { "enum": ["bind-address", "service-cluster-ip-range"] } } } } }] },
        "controllerManagerExtraArgs": { "allOf": [{ "$ref": "#/$defs/args" }, { "items": { "properties": { "name": { "not": { "enum": ["allocate-node-cidrs", "cluster-cidr", "service-cluster-ip-range"] } } } } }] },
        "schedulerExtraArgs": { "$ref": "#/$defs/args" },
        "kubeletExtraArgs": { "$ref": "#/$defs/kubeletArgs" },
        "preKubeadmCommands": { "$ref": "#/$defs/commands" },
        "postKubeadmCommands": { "$ref": "#/$defs/commands" },
        "certificateValidityPeriodDays": { "type": "integer", "minimum": 1, "maximum": 1095 },
        "certificatesExpiryDays": { "type": "integer", "minimum": 7 }
      }
    },
    "worker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "flavor", "profilesExtra", "devicesExtra", "kubeletExtraArgs", "preKubeadmCommands",
                   "postKubeadmCommands"],
      "properties": {
        "image": { "$ref": "#/$defs/image" },
        "flavor": { "type": "string" },
        "profilesExtra": { "$ref": "#/$defs/names" },
        "devicesExtra": { "$ref": "#/$defs/devices" },
        "kubeletExtraArgs": { "$ref": "#/$defs/kubeletArgs" },
        "preKubeadmCommands": { "$ref": "#/$defs/commands" },
        "postKubeadmCommands": { "$ref": "#/$defs/commands" }
      }
    },
    "loadBalancer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "flavor", "target", "disableHealthzCheck", "profilesExtra"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "server": { "type": "string", "minLength": 1 },
            "protocol": { "type": "string", "minLength": 1 },
            "fingerprint": { "type": "string", "minLength": 1 }
          }
        },
        "flavor": { "type": "string" },
        "target": { "type": "string" },
        "disableHealthzCheck": { "type": "boolean" },
        "profilesExtra": { "$ref": "#/$defs/names" }
      }
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "fingerprint": { "type": "string" }
      }
    },
    "names": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "devices": { "type": "array", "items": { "type": "string", "pattern": "^[^,]+,[^,]+=[^,]+(,[^,]+=[^,]+)*$" } },
    "commands": { "type": "array", "items": { "type": "string" } },
    "args": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 256 },
          "value": { "type": "string", "maxLength": 1024 }
        }
      }
    },
    "kubeletArgs": {
      "allOf": [
        { "$ref": "#/$defs/args" },
        { "items": { "properties": { "name": { "not": { "enum": ["feature-gates", "node-ip", "provider-id"] } } } } }
      ]
    }
  }
}
