global
  log /dev/log local0
  log /dev/log local1 notice
  daemon
  maxconn 100000

defaults
  log global
  mode tcp
  option dontlognull
  timeout connect 5000
  timeout client 50000
  timeout server 50000
  default-server init-addr none

frontend stats
  mode http
  bind 127.0.0.1:8404
  stats enable
  stats uri /stats
  stats refresh 1s

frontend control-plane
  bind 0.0.0.0:{{ .FrontendControlPlanePort }}
  bind :::{{ .FrontendControlPlanePort }} v6only
  default_backend kube-apiservers

backend kube-apiservers
  {{ if .EnableHealthzCheck -}}
  option httpchk GET /healthz
  {{- end }}
  {{range $server, $backend := .BackendServers}}
  server {{ $server }} {{ JoinHostPort $backend.Address $.BackendControlPlanePort }} weight {{ $backend.Weight }} check check-ssl verify none
  {{- end}}
