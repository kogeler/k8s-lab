{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "capi-workload-cluster values",
  "type": "object",
  "additionalProperties": false,
  "required": ["cluster", "kubernetes", "topology", "clusterNetwork", "apiProxy", "tests"],
  "properties": {
    "global": { "type": "object" },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 40, "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$" },
        "classRevision": { "type": "integer", "minimum": 0 }
      }
    },
    "kubernetes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controlPlane", "workers"],
      "properties": {
        "controlPlane": {
          "type": "object",
          "additionalProperties": false,
          "required": ["replicas"],
          "properties": { "replicas": { "type": "integer", "minimum": 1, "maximum": 99 } }
        },
        "workers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["replicas"],
          "properties": { "replicas": { "type": "integer", "minimum": 0, "maximum": 999 } }
        }
      }
    },
    "clusterNetwork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pods", "services"],
      "properties": {
        "pods": { "$ref": "#/$defs/dualStack" },
        "services": { "$ref": "#/$defs/dualStack" }
      }
    },
    "apiProxy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["infrastructureSecretName", "listenAddress", "port", "image", "timeoutSeconds"],
      "properties": {
        "infrastructureSecretName": { "type": "string", "minLength": 1, "maxLength": 253 },
        "listenAddress": { "type": "string", "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}|[0-9a-fA-F:]*:[0-9a-fA-F:]*)$" },
        "port": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "image": { "type": "string", "minLength": 1 },
        "timeoutSeconds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["loadBalancer", "kubeconfig", "proxy", "livez"],
          "properties": {
            "loadBalancer": { "$ref": "#/$defs/seconds" },
            "kubeconfig": { "$ref": "#/$defs/seconds" },
            "proxy": { "$ref": "#/$defs/seconds" },
            "livez": { "$ref": "#/$defs/seconds" }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "timeoutSeconds"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "timeoutSeconds": { "$ref": "#/$defs/seconds" }
      }
    }
  },
  "$defs": {
    "seconds": { "type": "integer", "minimum": 30, "maximum": 7200 },
    "dualStack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cidrBlocks"],
      "properties": {
        "cidrBlocks": {
          "description": "[IPv4, IPv6], in that order.",
          "type": "array",
          "minItems": 2,
          "prefixItems": [
            { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]{1,2}$" },
            { "type": "string", "pattern": "^[0-9a-fA-F:]*:[0-9a-fA-F:]*/[0-9]{1,3}$" }
          ],
          "items": false
        }
      }
    }
  }
}
