{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["calico", "tests"],
  "properties": {
    "global": { "type": "object" },
    "calico": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pods"],
      "properties": {
        "pods": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cidrBlocks"],
          "properties": {
            "cidrBlocks": {
              "description": "[IPv4, IPv6], in that order.",
              "type": "array",
              "minItems": 2,
              "prefixItems": [
                { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+\\.[0-9]+/[0-9]{1,2}$" },
                { "type": "string", "pattern": "^[0-9a-fA-F:]*:[0-9a-fA-F:]*/[0-9]{1,3}$" }
              ],
              "items": false
            }
          }
        }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "kubectlImage", "probePort", "timeoutSeconds"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "kubectlImage": { "type": "string", "minLength": 1 },
        "probePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "timeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 }
      }
    }
  }
}
