{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["pool", "l2", "tests"],
  "properties": {
    "global": { "type": "object" },
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rangeV6"],
      "properties": {
        "rangeV6": { "type": "string", "pattern": "^[0-9a-fA-F:]*:[0-9a-fA-F:]*-[0-9a-fA-F:]*:[0-9a-fA-F:]*$" }
      }
    },
    "l2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["extraNodeSelectors"],
      "properties": {
        "extraNodeSelectors": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "probePort", "timeoutSeconds"],
      "properties": {
        "image": { "type": "string", "minLength": 1 },
        "probePort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "timeoutSeconds": { "type": "integer", "minimum": 30, "maximum": 3600 }
      }
    }
  }
}
