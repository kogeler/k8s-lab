---
# ansible-lint contract for this repo.
# Roles stay native-first; the `command-instead-of-*` and `no-changed-when`
# rules stay on so shell fallbacks stay visible.

profile: production

exclude_paths:
  - .git/
  - .cache/
  - .ansible/
  - .vagrant/
  - .terraform/
  - .artifacts/
  - collections/
  - tests/fixtures/

# A vars file next to the reference playbooks (applied with `-e @file`), not a
# playbook.
kinds:
  - vars: "**/tests/playbooks/alt-vars.yml"

use_default_rules: true

skip_list:
  # Role directories are snake_case by convention (kebab-case is for task
  # names only).
  - role-name
  # Task names are `<role-kebab> | <area> | <action>`, lowercase role first.
  - name[casing]
  # `.yamllint` is the repo-level source of truth for YAML style — it
  # deliberately permits column-aligned values (max-spaces-after: -1) for
  # readability of defaults files. ansible-lint re-applies stricter default
  # yamllint rules here, which conflict with the convention.
  - yaml[colons]
  # Line length is a yamllint warning (`.yamllint`); ansible-lint would make it
  # an error.
  - yaml[line-length]

warn_list:
  - experimental
  - fqcn[action-core]
