# Managed by the k8s-lab bootstrap role; upstream's unit, configured by
# /etc/rancher/k3s/config.yaml.
[Unit]
Description=k3s server of the k8s-lab bootstrap cluster
Documentation=https://k3s.io
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
ExecStart=/usr/local/bin/k3s server

[Install]
WantedBy=multi-user.target
