# Runner-side kubeconfigs and the Terraform handoff (mode 0600, never committed).
.artifacts/*
!.artifacts/.gitkeep

# Vagrant runtime state, including the generated ssh-config
.vagrant/
**/.vagrant/

# Terraform state (local state only for the test fixtures)
**/.terraform/
terraform/modules/**/.terraform.lock.hcl
**/terraform.tfstate
**/terraform.tfstate.backup
**/terraform.tfstate.d/
**/.terraform.tfstate.lock.info
# Saved plans carry every value of the plan, secrets included.
**/*.tfplan
**/*.plan
**/crash.log
**/*.tfvars
**/*.tfvars.json
# The test fixture's per-cluster values (no secrets).
!tests/fixtures/terraform/**/terraform.tfvars

# Ansible (collections installed by `make deps`; ansible-lint's work directory)
*.retry
ansible/collections/
.ansible/

# Helm
charts/**/charts/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# MkDocs build output, `make check` caches, Molecule state
site/
.cache/

# Editor / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Local env overrides
.env
.env.local

.claude

tmp/